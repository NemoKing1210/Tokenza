{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokenza",
  "version": "0.1.0",
  "identifier": "app.tokenza.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "flyout",
        "url": "index.html?view=flyout",
        "title": "Tokenza",
        "width": 360,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "settings",
        "url": "index.html?view=settings",
        "title": "Tokenza — Settings",
        "width": 880,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}